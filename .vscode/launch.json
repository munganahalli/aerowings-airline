{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch AeroWings Full App (npm run dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    },
    {
      "name": "2. Run Standalone OTP Backend (node otp-backend.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/otp-backend.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "OTP_PORT": "5001"
      }
    },
    {
      "name": "3. Debug Server with TSX (server.ts)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
